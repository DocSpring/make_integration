{
    "url": "/templates",
    "method": "GET",
    "headers": {
        "Authorization": "Basic {{base64(connection.token_id + \":\" + connection.token_secret)}}"
    },
    "qs": {
        "limit": 100
    },
    "response": {
        "limit": 1000,
        "iterate": "{{body.data}}",
        "output": {
            "label": "{{ifempty(item.name; item.id) + if(item.path = '/'; ''; ' (' + item.path + ')')}}",
            "value": "{{item.id}}"
        }
    },
    "pagination": {
        "qs": {
            "cursor": "{{body.next_cursor}}"
        },
        "condition": "{{body.next_cursor}}"
    }
}
