{
    "condition": "{{trim(parameters.template_id) != '.' && trim(parameters.template_id) != '..'}}",
    "url": "/templates/{{encodeURL(trim(parameters.template_id))}}/fields",
    "method": "GET",
    "headers": {
        "Authorization": "Basic {{base64(connection.token_id + \":\" + connection.token_secret)}}"
    },
    "qs": {
        "version": "{{ifempty(parameters.version; 'latest')}}"
    },
    "response": {
        "iterate": {
            "container": "{{distinct(body.fields; 'name')}}",
            "condition": "{{ifempty(item.name; '') != '' && !item.static && item.type != 'combined' && indexOf(ifempty(item.name; ''); '@@') != 0}}"
        },
        "output": {
            "label": "{{item.name}}",
            "value": "{{item.name}}"
        }
    }
}
