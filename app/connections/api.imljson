{
    "url": "{{if(parameters.region = \"self_hosted\"; if(contains(parameters.custom_host; \"://\"); parameters.custom_host; \"https://\" + parameters.custom_host); \"https://\" + switch(parameters.region; \"eu\"; \"api-eu.docspring.com\"; \"api.docspring.com\"))}}/api/v1/authentication",
    "method": "GET",
    "headers": {
        "Authorization": "Basic {{base64(parameters.token_id + \":\" + parameters.token_secret)}}",
        "Accept": "application/json"
    },
    "response": {
        "valid": "{{body.status = \"success\"}}",
        "error": {
            "message": "[{{statusCode}}] Invalid DocSpring API token. Check your token ID, secret, and region."
        }
    },
    "log": {
        "sanitize": ["request.headers.authorization"]
    }
}
