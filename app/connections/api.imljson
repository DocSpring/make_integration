{
    "url": "{{if(parameters.region = \"self_hosted\"; parameters.custom_host; \"https://\" + switch(parameters.region; \"eu\"; \"api-eu.docspring.com\"; \"au\"; \"api-au.docspring.com\"; \"api.docspring.com\"))}}/api/v1/authentication",
    "method": "GET",
    "headers": {
        "Authorization": "Basic {{base64(parameters.token_id + \":\" + parameters.token_secret)}}",
        "Accept": "application/json"
    },
    "response": {
        "valid": "{{body.status = \"success\"}}",
        "error": {
            "message": "[{{statusCode}}] Invalid DocSpring API token. Check your Token ID, secret, and region."
        }
    }
}
