[
    {
        "name": "region",
        "type": "select",
        "label": "Region",
        "required": true,
        "default": "us",
        "options": [
            { "label": "United States", "value": "us" },
            { "label": "Europe", "value": "eu" },
            { "label": "Self-hosted / Enterprise", "value": "self_hosted" }
        ]
    },
    {
        "name": "custom_host",
        "type": "text",
        "label": "Self-hosted host",
        "editable": false,
        "help": "Only for the Self-hosted / Enterprise region — your full DocSpring URL, e.g. https://docspring.example.com (https:// is added if you omit it). This cannot be changed after the connection is created."
    },
    { "name": "token_id", "type": "text", "label": "API token ID", "required": true },
    { "name": "token_secret", "type": "password", "label": "API token secret", "required": true }
]
