{
    "url": "/templates",
    "method": "GET",
    "qs": {
        "query": "{{parameters.query}}",
        "per_page": 50
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": "{{body}}",
        "output": {
            "id": "{{item.id}}",
            "name": "{{item.name}}",
            "template_type": "{{item.template_type}}",
            "document_state": "{{item.document_state}}",
            "updated_at": "{{item.updated_at}}"
        }
    },
    "pagination": {
        "qs": { "page": "{{pagination.page}}" },
        "condition": "{{length(body) >= 50}}"
    }
}
