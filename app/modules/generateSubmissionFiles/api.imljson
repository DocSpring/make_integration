[
    {
        "condition": "{{trim(parameters.submission_id) = '.' || trim(parameters.submission_id) = '..'}}",
        "response": {
            "valid": {
                "condition": "{{false}}",
                "message": "The submission ID can't be \".\" or \"..\".",
                "type": "DataError"
            }
        }
    },
    {
        "url": "{{if(connection.region = \"self_hosted\"; if(contains(connection.custom_host; \"://\"); connection.custom_host; \"https://\" + connection.custom_host); \"https://\" + switch(connection.region; \"eu\"; \"sync.api-eu.docspring.com\"; \"sync.api.docspring.com\"))}}/api/v2/submissions/{{encodeURL(trim(parameters.submission_id))}}/generate_files",
        "method": "POST",
        "headers": {
            "Authorization": "Basic {{base64(connection.token_id + \":\" + connection.token_secret)}}",
            "Accept": "application/json",
            "User-Agent": "docspring-make/2"
        },
        "qs": {
            "wait": "{{parameters.wait}}"
        },
        "body": {
            "formats": "{{parameters.formats}}"
        },
        "response": {
            "valid": {
                "condition": "{{if(contains(parameters.formats; 'pdf'); body.files.pdf.state != 'error'; true) && if(contains(parameters.formats; 'docx'); body.files.docx.state != 'error'; true) && if(contains(parameters.formats; 'odt'); body.files.odt.state != 'error'; true) && if(contains(parameters.formats; 'png'); body.files.png.state != 'error'; true)}}",
                "message": "DocSpring couldn't make some of the files.{{if(contains(parameters.formats; 'pdf') && body.files.pdf.state = 'error'; ' PDF: ' + body.files.pdf.error_message; '')}}{{if(contains(parameters.formats; 'docx') && body.files.docx.state = 'error'; ' Word document: ' + body.files.docx.error_message; '')}}{{if(contains(parameters.formats; 'odt') && body.files.odt.state = 'error'; ' OpenDocument file: ' + body.files.odt.error_message; '')}}{{if(contains(parameters.formats; 'png') && body.files.png.state = 'error'; ' Page images: ' + body.files.png.error_message; '')}}\nSubmission: {{body.id}}"
            },
            "output": "{{body}}"
        },
        "log": {
            "sanitize": [
                "request.headers.authorization"
            ]
        }
    }
]
