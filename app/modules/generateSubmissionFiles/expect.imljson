[
    {
        "name": "submission_id",
        "type": "text",
        "label": "Submission ID",
        "required": true,
        "help": "The submission's ID, such as sub_1234567890abcdef01."
    },
    {
        "name": "formats",
        "type": "select",
        "label": "Formats",
        "multiple": true,
        "required": true,
        "default": [
            "png"
        ],
        "options": [
            {
                "label": "PNG image of each page",
                "value": "png"
            },
            {
                "label": "PDF (Word templates that made only a Word document)",
                "value": "pdf"
            },
            {
                "label": "Word document (Word templates)",
                "value": "docx"
            },
            {
                "label": "OpenDocument file (Word templates)",
                "value": "odt"
            }
        ],
        "help": "The files to add. PDF, Word document and OpenDocument file are for the submissions of Word templates. A format the submission already has is left as it is."
    },
    {
        "name": "wait",
        "type": "boolean",
        "label": "Wait for the files",
        "default": true,
        "advanced": true,
        "help": "Yes waits until the files are ready. No returns straight away: get them later, or use the Watch events trigger."
    }
]
