[
    {
        "name": "submission_id",
        "type": "text",
        "label": "Submission ID",
        "required": true,
        "help": "The submission's ID, such as sub_1234567890abcdef01."
    },
    {
        "name": "formats",
        "type": "select",
        "label": "Formats",
        "multiple": true,
        "required": true,
        "default": [
            "png"
        ],
        "options": [
            {
                "label": "PNG image of each page",
                "value": "png"
            }
        ]
    },
    {
        "name": "wait",
        "type": "boolean",
        "label": "Wait for the files",
        "default": true,
        "advanced": true,
        "help": "Yes waits until the files is ready. No returns straight away: get it later, or use the Watch events trigger."
    }
]
