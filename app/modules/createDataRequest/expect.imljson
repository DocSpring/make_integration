[
    { "name": "template_id", "type": "select", "label": "Template", "required": true, "options": { "store": "rpc://listTemplates", "nested": "rpc://templateFields" } },
    { "name": "data_requests", "type": "array", "label": "Recipients", "required": true, "spec": [
        { "name": "email", "type": "email", "label": "Email", "required": true },
        { "name": "name", "type": "text", "label": "Name" },
        { "name": "fields", "type": "text", "label": "Fields", "help": "Comma-separated field names this person must fill. Leave blank (single recipient) for all fields." },
        { "name": "auth_type", "type": "select", "label": "Authentication", "default": "email_link", "options": [ { "label": "Email link (recommended)", "value": "email_link" }, { "label": "Password", "value": "password" }, { "label": "OAuth", "value": "oauth" }, { "label": "Phone number", "value": "phone_number" } ] }
    ] },
    { "name": "test", "type": "boolean", "label": "Test?", "default": false },
    { "name": "expires_in", "type": "number", "label": "Expires In (seconds)" }
]
