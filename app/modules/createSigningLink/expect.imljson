[
    {
        "name": "signature_request_id",
        "type": "text",
        "label": "Signature request ID",
        "required": true,
        "help": "The signature request's ID, such as srq_1234567890abcdef01. Create signature request outputs one for each signer."
    },
    {
        "name": "type",
        "type": "select",
        "label": "Link type",
        "required": true,
        "default": "email",
        "options": [
            {
                "label": "Email link (opens the form for 7 days)",
                "value": "email"
            },
            {
                "label": "API link (opens the form for 24 hours)",
                "value": "api"
            }
        ],
        "help": "A form that opened in time keeps working for 7 more days. Create a new link each time you send one."
    }
]
