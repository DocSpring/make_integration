[
    {
        "name": "template_id",
        "type": "select",
        "label": "Template",
        "required": true,
        "options": {
            "store": "rpc://listTemplates",
            "nested": [
                {
                    "name": "version",
                    "type": "select",
                    "label": "Template version",
                    "dynamic": true,
                    "help": "The template version to use: the latest published version (the draft when none has been published), the draft, or a published version number such as 1.2.0, or 1 for the latest 1.x.x (switch on Map to type one).",
                    "default": "latest",
                    "options": {
                        "store": [
                            {
                                "label": "Latest published version",
                                "value": "latest"
                            },
                            {
                                "label": "Draft",
                                "value": "draft"
                            }
                        ],
                        "nested": "rpc://templateFields?optional=true"
                    }
                }
            ]
        }
    },
    {
        "name": "signature_requests",
        "type": "array",
        "label": "Signers",
        "help": "The people who fill in and sign the PDF. DocSpring generates the PDF once every signer has finished.",
        "spec": [
            {
                "name": "name",
                "type": "text",
                "label": "Name"
            },
            {
                "name": "email",
                "type": "email",
                "label": "Email",
                "help": "Required when DocSpring emails the signers."
            },
            {
                "name": "fields",
                "type": "array",
                "label": "Fields",
                "required": true,
                "spec": {
                    "type": "text",
                    "label": "Field name"
                },
                "help": "The names of the fields this person fills in, as List template fields shows them (such as `address/street`). Each field can be in only one signer's list."
            },
            {
                "name": "role",
                "type": "text",
                "label": "Role",
                "help": "Which of the template's signers this person is: Signer 1, Signer 2 and so on. Give every signer a role, or none."
            },
            {
                "name": "auth_type",
                "type": "select",
                "label": "Authentication",
                "required": true,
                "default": "email_link",
                "options": [
                    {
                        "label": "Email link",
                        "value": "email_link"
                    },
                    {
                        "label": "Password",
                        "value": "password"
                    },
                    {
                        "label": "OAuth",
                        "value": "oauth",
                        "nested": [
                            {
                                "name": "auth_provider",
                                "type": "text",
                                "label": "Auth provider",
                                "required": true,
                                "help": "The service that signed the person in, such as google."
                            }
                        ]
                    },
                    {
                        "label": "Phone number",
                        "value": "phone_number"
                    },
                    {
                        "label": "LDAP",
                        "value": "ldap"
                    },
                    {
                        "label": "SAML",
                        "value": "saml"
                    }
                ],
                "help": "How the person is identified before they see the form. Choose Email link when they get their link by email, from DocSpring or from you: DocSpring's emails always use it. The other types are for people you send the link to yourself or who sign in your app."
            },
            {
                "name": "signing_step",
                "type": "uinteger",
                "label": "Signing step",
                "validate": {
                    "min": 1,
                    "max": 100
                },
                "help": "With Signing order One step at a time: when this person signs. Everyone in step 1 signs first, then step 2, and so on, and people in the same step sign in any order. Give every signer a step, or none to have them sign in the order of this list."
            },
            {
                "name": "prefilled_values_editable",
                "type": "boolean",
                "label": "Can change prefilled values",
                "help": "Let the person change the values already filled in for their fields."
            },
            {
                "name": "ignore_unknown_fields",
                "type": "boolean",
                "label": "Ignore unknown fields",
                "help": "Leave out field names that the template doesn't have, instead of failing."
            }
        ],
        "required": true
    },
    {
        "name": "signing_order",
        "type": "select",
        "label": "Signing order",
        "default": "parallel",
        "options": [
            {
                "label": "Everyone at once",
                "value": "parallel"
            },
            {
                "label": "One step at a time",
                "value": "sequential"
            }
        ],
        "help": "One step at a time: people sign in the order of their Signing step, or of the Signers list. DocSpring emails each step when the one before it is done; when you send the links, send each step's once the step before it has signed."
    },
    {
        "name": "send_email",
        "type": "select",
        "label": "Emails to signers",
        "required": true,
        "default": "docspring",
        "options": [
            {
                "label": "DocSpring emails each signer their link",
                "value": "docspring",
                "nested": [
                    {
                        "name": "email_subject",
                        "type": "text",
                        "label": "Email subject",
                        "validate": {
                            "max": 200
                        },
                        "help": "The subject of the emails that ask people to sign. Leave it empty for \"<your name> sent you <document> to sign\"."
                    },
                    {
                        "name": "email_message",
                        "type": "text",
                        "label": "Message",
                        "multiline": true,
                        "validate": {
                            "max": 2000
                        },
                        "help": "A message for the signers, shown above the signing button. Links and web addresses are shown as plain text."
                    },
                    {
                        "name": "cc",
                        "type": "array",
                        "label": "CC",
                        "spec": {
                            "type": "email",
                            "label": "Email"
                        },
                        "validate": {
                            "maxItems": 10
                        },
                        "help": "Up to 10 people who get the signed PDF. They don't sign."
                    },
                    {
                        "name": "reminders",
                        "type": "collection",
                        "label": "Reminders",
                        "spec": [
                            {
                                "name": "interval_days",
                                "type": "uinteger",
                                "label": "Days between reminders",
                                "validate": {
                                    "min": 1,
                                    "max": 30
                                }
                            },
                            {
                                "name": "max_count",
                                "type": "uinteger",
                                "label": "Most reminders per person",
                                "validate": {
                                    "min": 1,
                                    "max": 10
                                }
                            }
                        ],
                        "help": "Remind people who haven't signed. Leave both empty for no reminders."
                    },
                    {
                        "name": "reply_to",
                        "type": "email",
                        "label": "Reply-to address",
                        "help": "Where replies to the emails go: a member of your DocSpring team, or an address at one of your verified email domains. Leave it empty for the template's reply-to address (the account owner when it has none)."
                    },
                    {
                        "name": "notification_emails",
                        "type": "array",
                        "label": "Notification emails",
                        "spec": {
                            "type": "email",
                            "label": "Email"
                        },
                        "validate": {
                            "maxItems": 10
                        },
                        "help": "Up to 10 addresses that DocSpring tells when the document is completed or declined, or an email bounces or can't be sent: members of your DocSpring team or addresses at your verified email domains. Leave it empty for the template's notification addresses (the account owner when it has none)."
                    },
                    {
                        "name": "notify_when_signed",
                        "type": "boolean",
                        "label": "Notify when each person signs",
                        "help": "Also email the notification addresses each time someone signs."
                    }
                ]
            },
            {
                "label": "I send the links, or open them in my app",
                "value": "self",
                "nested": [
                    {
                        "name": "signing_link_type",
                        "type": "select",
                        "label": "Signing links",
                        "required": true,
                        "default": "email",
                        "options": [
                            {
                                "label": "Email links (open the form for 7 days)",
                                "value": "email"
                            },
                            {
                                "label": "API links (open the form for 24 hours)",
                                "value": "api"
                            },
                            {
                                "label": "No links",
                                "value": "none"
                            }
                        ],
                        "help": "Creates a link for each signer, in Signing links. Send an email link to the person; open an API link in your app straight away."
                    }
                ]
            }
        ],
        "help": "DocSpring emails each signer a link to sign, any reminders, and the signed PDF once everyone has signed. A test submission only emails members of your DocSpring team. DocSpring doesn't email the signers of a form library template: choose I send the links for one."
    },
    {
        "name": "test",
        "type": "boolean",
        "label": "Test",
        "help": "Test PDFs are free and have a watermark. A test API token always makes test PDFs."
    },
    {
        "name": "metadata",
        "type": "array",
        "label": "Metadata",
        "help": "Your own data about the submission, such as an ID from your app.",
        "spec": [
            {
                "name": "key",
                "type": "text",
                "label": "Key",
                "required": true
            },
            {
                "name": "value",
                "type": "text",
                "label": "Value"
            }
        ]
    }
]
