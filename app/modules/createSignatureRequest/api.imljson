[
    {
        "condition": "{{trim(parameters.template_id) = '.' || trim(parameters.template_id) = '..'}}",
        "response": {
            "valid": {
                "condition": "{{false}}",
                "message": "The template ID can't be \".\" or \"..\".",
                "type": "DataError"
            }
        }
    },
    {
        "url": "/templates/{{encodeURL(trim(parameters.template_id))}}/submissions",
        "method": "POST",
        "qs": {
            "version": "{{parameters.version}}"
        },
        "body": {
            "data": {
                "{{...}}": "{{parameters.data}}"
            },
            "test": "{{if(parameters.test; true; undefined)}}",
            "metadata": "{{if(parameters.metadata; toCollection(parameters.metadata; 'key'; 'value'); undefined)}}",
            "signature_requests": "{{parameters.signature_requests}}",
            "signing_order": "{{parameters.signing_order}}",
            "send_email": "{{parameters.send_email != 'self'}}",
            "email_subject": "{{if(parameters.send_email != 'self'; parameters.email_subject; undefined)}}",
            "email_message": "{{if(parameters.send_email != 'self'; parameters.email_message; undefined)}}",
            "cc": "{{if(parameters.send_email != 'self' && length(ifempty(parameters.cc; emptyarray)) > 0; distinct(parameters.cc); undefined)}}",
            "reminders": "{{if(parameters.send_email != 'self' && (parameters.reminders.interval_days || parameters.reminders.max_count); parameters.reminders; undefined)}}",
            "reply_to": "{{if(parameters.send_email != 'self'; parameters.reply_to; undefined)}}",
            "notification_emails": "{{if(parameters.send_email != 'self' && length(ifempty(parameters.notification_emails; emptyarray)) > 0; distinct(parameters.notification_emails); undefined)}}",
            "notify_when_signed": "{{if(parameters.send_email != 'self' && parameters.notify_when_signed; true; undefined)}}"
        },
        "response": {
            "temp": {
                "submission": "{{body}}",
                "signature_request_ids": "{{map(body.signature_requests; 'id')}}",
                "signing_links": "{{emptyarray}}",
                "index": 1
            }
        }
    },
    {
        "condition": "{{parameters.send_email = 'self' && parameters.signing_link_type != 'none' && length(temp.signature_request_ids) > 0}}",
        "url": "/signature_requests/{{encodeURL(get(temp.signature_request_ids; temp.index))}}/tokens",
        "method": "POST",
        "body": {
            "type": "{{parameters.signing_link_type}}"
        },
        "response": {
            "temp": {
                "signing_links": "{{add(temp.signing_links; body)}}",
                "index": "{{temp.index + 1}}"
            }
        },
        "repeat": {
            "condition": "{{temp.index <= length(temp.signature_request_ids)}}",
            "delay": 100,
            "limit": 100
        }
    },
    {
        "response": {
            "output": {
                "{{...}}": "{{temp.submission}}",
                "signing_links": "{{temp.signing_links}}",
                "first_signature_request_id": "{{temp.signature_request_ids[1]}}",
                "first_signing_url": "{{temp.signing_links[1].signature_request_url}}"
            }
        }
    }
]
