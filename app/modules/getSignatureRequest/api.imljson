[
    {
        "condition": "{{trim(parameters.signature_request_id) = '.' || trim(parameters.signature_request_id) = '..'}}",
        "response": {
            "valid": {
                "condition": "{{false}}",
                "message": "The signature request ID can't be \".\" or \"..\".",
                "type": "DataError"
            }
        }
    },
    {
        "url": "/signature_requests/{{encodeURL(trim(parameters.signature_request_id))}}",
        "method": "GET",
        "response": {
            "output": "{{body}}"
        }
    }
]
