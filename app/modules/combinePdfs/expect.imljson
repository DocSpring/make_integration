[
    {
        "name": "source_pdfs",
        "type": "array",
        "label": "Source PDFs",
        "required": true,
        "help": "The PDFs to merge, in order.",
        "spec": [
            {
                "name": "type",
                "type": "select",
                "label": "Type",
                "required": true,
                "default": "submission",
                "options": [
                    {
                        "label": "Submission",
                        "value": "submission",
                        "nested": [
                            {
                                "name": "id",
                                "type": "text",
                                "label": "Submission ID",
                                "required": true
                            }
                        ]
                    },
                    {
                        "label": "Combined PDF",
                        "value": "combined_pdf",
                        "nested": [
                            {
                                "name": "id",
                                "type": "text",
                                "label": "Combined PDF ID",
                                "required": true
                            }
                        ]
                    },
                    {
                        "label": "Template",
                        "value": "template",
                        "nested": [
                            {
                                "name": "id",
                                "type": "text",
                                "label": "Template ID",
                                "required": true
                            },
                            {
                                "name": "template_version",
                                "type": "text",
                                "label": "Template version",
                                "help": "A published version, such as 1.2.0, or latest or draft. Leave it empty for the latest published version."
                            },
                            {
                                "name": "processed",
                                "type": "boolean",
                                "label": "Processed PDF",
                                "help": "No merges the template's original PDF instead of the processed one that PDFs are generated from."
                            }
                        ]
                    },
                    {
                        "label": "Custom file",
                        "value": "custom_file",
                        "nested": [
                            {
                                "name": "id",
                                "type": "text",
                                "label": "Custom file ID",
                                "required": true
                            }
                        ]
                    },
                    {
                        "label": "URL",
                        "value": "url",
                        "nested": [
                            {
                                "name": "url",
                                "type": "url",
                                "label": "PDF URL",
                                "required": true
                            }
                        ]
                    }
                ]
            }
        ]
    },
    {
        "name": "metadata",
        "type": "array",
        "label": "Metadata",
        "help": "Your own data about the combined PDF, such as an ID from your app.",
        "spec": [
            {
                "name": "key",
                "type": "text",
                "label": "Key",
                "required": true
            },
            {
                "name": "value",
                "type": "text",
                "label": "Value"
            }
        ]
    },
    {
        "name": "password",
        "type": "text",
        "label": "PDF password",
        "advanced": true,
        "help": "A password that the PDF needs to be opened with. DocSpring never returns it."
    },
    {
        "name": "expires_in",
        "type": "uinteger",
        "label": "Expires in (seconds)",
        "advanced": true,
        "help": "Seconds after the PDF is generated until DocSpring deletes it, up to 315360000 (10 years)."
    },
    {
        "name": "wait",
        "type": "boolean",
        "label": "Wait for the PDF",
        "default": true,
        "advanced": true,
        "help": "Yes waits until the PDF is ready. No returns straight away: get it later, or use the Watch events trigger."
    }
]
