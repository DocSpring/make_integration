{
    "url": "{{if(connection.region = \"self_hosted\"; if(contains(connection.custom_host; \"://\"); connection.custom_host; \"https://\" + connection.custom_host); \"https://\" + switch(connection.region; \"eu\"; \"sync.api-eu.docspring.com\"; \"sync.api.docspring.com\"))}}/api/v2/combined_pdfs",
    "method": "POST",
    "headers": {
        "Authorization": "Basic {{base64(connection.token_id + \":\" + connection.token_secret)}}",
        "Accept": "application/json",
        "User-Agent": "docspring-make/2"
    },
    "qs": {
        "wait": "{{parameters.wait}}"
    },
    "body": {
        "source_pdfs": "{{parameters.source_pdfs}}",
        "metadata": "{{if(parameters.metadata; toCollection(parameters.metadata; 'key'; 'value'); undefined)}}",
        "password": "{{parameters.password}}",
        "expires_in": "{{parameters.expires_in}}"
    },
    "response": {
        "valid": {
            "condition": "{{body.state != 'error'}}",
            "message": "DocSpring couldn't combine the PDFs (state: {{body.state}}): {{body.error_message}}\nCombined PDF: {{body.id}}"
        },
        "output": "{{body}}"
    },
    "log": {
        "sanitize": [
            "request.headers.authorization",
            "request.body.password"
        ]
    }
}
