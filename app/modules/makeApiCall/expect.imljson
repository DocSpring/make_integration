[
    {
        "name": "url",
        "type": "text",
        "label": "URL",
        "required": true,
        "help": "A path relative to the DocSpring API base for your region, which already includes /api/v2. For example: /templates or /submissions/sub_1234567890abcdef01."
    },
    {
        "name": "method",
        "type": "select",
        "label": "Method",
        "required": true,
        "default": "GET",
        "options": [
            {
                "label": "GET",
                "value": "GET"
            },
            {
                "label": "POST",
                "value": "POST"
            },
            {
                "label": "PUT",
                "value": "PUT"
            },
            {
                "label": "PATCH",
                "value": "PATCH"
            },
            {
                "label": "DELETE",
                "value": "DELETE"
            }
        ]
    },
    {
        "name": "headers",
        "type": "array",
        "label": "Headers",
        "help": "You don't have to add an Authorization header: the app adds it for you.",
        "spec": [
            {
                "name": "key",
                "type": "text",
                "label": "Key"
            },
            {
                "name": "value",
                "type": "text",
                "label": "Value"
            }
        ],
        "default": [
            {
                "key": "Content-Type",
                "value": "application/json"
            }
        ]
    },
    {
        "name": "qs",
        "type": "array",
        "label": "Query string",
        "spec": [
            {
                "name": "key",
                "type": "text",
                "label": "Key"
            },
            {
                "name": "value",
                "type": "text",
                "label": "Value"
            }
        ]
    },
    {
        "name": "body",
        "type": "any",
        "label": "Body",
        "help": "A JSON body, such as {\"name\": \"Contracts\"}."
    }
]
