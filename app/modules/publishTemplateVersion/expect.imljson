[
    {
        "name": "template_id",
        "type": "select",
        "label": "Template",
        "required": true,
        "mode": "edit",
        "options": "rpc://listTemplates"
    },
    {
        "name": "version_type",
        "type": "select",
        "label": "Version type",
        "required": true,
        "default": "patch",
        "options": [
            {
                "label": "Patch (1.2.3 to 1.2.4)",
                "value": "patch"
            },
            {
                "label": "Minor (1.2.3 to 1.3.0)",
                "value": "minor"
            },
            {
                "label": "Major (1.2.3 to 2.0.0)",
                "value": "major"
            }
        ]
    },
    {
        "name": "description",
        "type": "text",
        "label": "Description",
        "help": "What changed in this version."
    }
]
