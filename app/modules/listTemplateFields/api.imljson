[
    {
        "condition": "{{trim(parameters.template_id) = '.' || trim(parameters.template_id) = '..'}}",
        "response": {
            "valid": {
                "condition": "{{false}}",
                "message": "The template ID can't be \".\" or \"..\".",
                "type": "DataError"
            }
        }
    },
    {
        "url": "/templates/{{encodeURL(trim(parameters.template_id))}}/fields",
        "method": "GET",
        "qs": {
            "version": "{{parameters.version}}"
        },
        "response": {
            "limit": "{{parameters.limit}}",
            "iterate": "{{body.fields}}",
            "output": "{{item}}"
        }
    }
]
