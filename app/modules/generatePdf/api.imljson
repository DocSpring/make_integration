{
    "url": "{{if(connection.region = \"self_hosted\"; connection.custom_host; \"https://\" + switch(connection.region; \"eu\"; \"sync.api-eu.docspring.com\"; \"au\"; \"sync.api-au.docspring.com\"; \"sync.api.docspring.com\"))}}/api/v1/templates/{{parameters.template_id}}/submissions",
    "method": "POST",
    "qs": { "wait": true },
    "headers": { "Authorization": "Basic {{base64(connection.token_id + \":\" + connection.token_secret)}}" },
    "body": {
        "data": "{{omit(parameters; \"template_id\"; \"test\"; \"pdf_passphrase\"; \"expires_in\"; \"editable\"; \"version\")}}",
        "test": "{{parameters.test}}",
        "password": "{{parameters.pdf_passphrase}}",
        "editable": "{{parameters.editable}}",
        "expires_in": "{{parameters.expires_in}}",
        "version": "{{parameters.version}}"
    },
    "response": {
        "output": {
            "id": "{{body.submission.id}}",
            "state": "{{body.submission.state}}",
            "download_url": "{{body.submission.download_url}}",
            "permanent_download_url": "{{body.submission.permanent_download_url}}",
            "expires_at": "{{body.submission.expires_at}}",
            "test": "{{body.submission.test}}",
            "pdf_hash": "{{body.submission.pdf_hash}}"
        }
    }
}
