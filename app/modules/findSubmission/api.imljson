{
    "url": "/submissions",
    "method": "GET",
    "qs": {
        "template_id": "{{parameters.template_id}}",
        "test": "{{if(parameters.mode = 'test'; true; if(parameters.mode = 'live'; false; undefined))}}",
        "created_after": "{{parameters.created_after}}",
        "created_before": "{{parameters.created_before}}",
        "include_data": "{{parameters.include_data}}",
        "limit": "{{if(parameters.limit > 0 && parameters.limit < 100; parameters.limit; 100)}}"
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": "{{body.data}}",
        "output": "{{item}}"
    },
    "pagination": {
        "qs": {
            "cursor": "{{body.next_cursor}}"
        },
        "condition": "{{body.next_cursor}}"
    }
}
