[
    {
        "name": "template_id",
        "type": "select",
        "label": "Template",
        "required": false,
        "options": "rpc://listTemplates",
        "help": "Only find this template's submissions. Leave it empty for every template."
    },
    {
        "name": "mode",
        "type": "select",
        "label": "Mode",
        "default": "any",
        "options": [
            {
                "label": "Live and test",
                "value": "any"
            },
            {
                "label": "Live only",
                "value": "live"
            },
            {
                "label": "Test only",
                "value": "test"
            }
        ]
    },
    {
        "name": "created_after",
        "type": "date",
        "label": "Created after"
    },
    {
        "name": "created_before",
        "type": "date",
        "label": "Created before"
    },
    {
        "name": "include_data",
        "type": "boolean",
        "label": "Include data",
        "help": "Include each submission's data."
    },
    {
        "name": "limit",
        "type": "uinteger",
        "label": "Limit",
        "default": 10,
        "help": "The most results to return."
    }
]
